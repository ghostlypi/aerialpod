<?xml version="1.0" encoding="utf-8"?>
<!--
  The API 30–31 form of the same rule as data_extraction_rules.xml, which only
  applies from Android 12. `allowBackup="false"` already covers this, but stating
  it in both forms leaves no version where the intent is implied rather than
  written down. Nothing here may be copied off the device — see the manifest.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
