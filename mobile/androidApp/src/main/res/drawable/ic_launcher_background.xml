<?xml version="1.0" encoding="utf-8"?>
<!--
  The artwork is a black disc on transparency. Filling the layer with the same
  black means whatever shape the launcher masks to — circle, squircle, rounded
  square — comes out solid rather than showing the disc floating on nothing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z" android:fillColor="#FF000000" />
</vector>
