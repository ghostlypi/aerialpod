<?xml version="1.0" encoding="utf-8"?>
<!--
  The themed-icon layer, which has to be a single-colour shape rather than
  artwork — so the mark is traced from the PNG rather than reusing it.
  Coordinates are the 512-canvas ones, scaled into the safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <group
        android:scaleX="0.66"
        android:scaleY="0.66"
        android:pivotX="256"
        android:pivotY="256">
        <path
            android:pathData="M 90,262 L 440,262"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="14"
            android:fillColor="#00000000" />
        <path
            android:pathData="M 90,140 L 90,262"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="14"
            android:fillColor="#00000000" />
        <path
            android:pathData="M 440,140 L 440,262"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="14"
            android:fillColor="#00000000" />
        <path
            android:pathData="M 264,143 L 264,395"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="14"
            android:fillColor="#00000000" />
    </group>
</vector>
