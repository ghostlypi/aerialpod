-- The queue, its exclusions, and — separately — the user intent that gets
-- replicated to peers.
--
-- `queue` and `queue_exclusions` are local derived truth, rebuilt by
-- reconcile() from episode state. What actually travels between peers is the
-- *user's decisions* — "I queued this", "I threw this out", "this is the order
-- I want" — because that is precisely what gpodder.net's protocol has no way
-- to express.
--
-- Keeping intent in its own table (rather than stamping the queue rows) buys
-- two things: a derived reshuffle never looks like an opinion worth pushing at
-- a peer, and un-excluding an episode is a *record* rather than a deletion —
-- otherwise a peer's older exclusion would win the merge and silently
-- re-exclude what the user just restored.

CREATE TABLE queue (
  episode_id INTEGER PRIMARY KEY REFERENCES episodes(id) ON DELETE CASCADE,
  position INTEGER NOT NULL,  -- 1024-gap scheme
  origin TEXT NOT NULL DEFAULT 'auto',  -- 'auto'|'manual'
  pinned INTEGER NOT NULL DEFAULT 0,
  added_at INTEGER NOT NULL
);

CREATE TABLE queue_exclusions (
  episode_id INTEGER PRIMARY KEY REFERENCES episodes(id) ON DELETE CASCADE,
  removed_at INTEGER NOT NULL
);

CREATE TABLE queue_intent (
  episode_id INTEGER PRIMARY KEY REFERENCES episodes(id) ON DELETE CASCADE,
  intent TEXT NOT NULL,                    -- 'queued' | 'excluded'
  position INTEGER NOT NULL DEFAULT 0,
  pinned INTEGER NOT NULL DEFAULT 0,
  origin TEXT NOT NULL DEFAULT 'manual',
  updated_at INTEGER NOT NULL,
  updated_by TEXT NOT NULL
);

queueItems:
SELECT * FROM queue ORDER BY position;

queueEpisodes:
SELECT e.* FROM queue q JOIN episodes e ON e.id = q.episode_id ORDER BY q.position;

queueEpisodeIds:
SELECT episode_id FROM queue;

queueItemFor:
SELECT * FROM queue WHERE episode_id = ?;

minQueuePosition:
SELECT MIN(position) FROM queue;

maxQueuePosition:
SELECT MAX(position) FROM queue;

insertQueueItem:
INSERT INTO queue(episode_id, position, origin, pinned, added_at) VALUES (?, ?, ?, ?, ?);

insertQueueItemIfAbsent:
INSERT OR IGNORE INTO queue(episode_id, position, origin, pinned, added_at)
VALUES (?, ?, ?, ?, ?);

upsertQueueItem:
INSERT INTO queue(episode_id, position, origin, pinned, added_at) VALUES (?, ?, ?, ?, ?)
ON CONFLICT(episode_id) DO UPDATE SET
  position = excluded.position, origin = excluded.origin, pinned = excluded.pinned;

setQueuePosition:
UPDATE queue SET position = ? WHERE episode_id = ?;

pinQueueItem:
UPDATE queue SET pinned = 1, origin = 'manual' WHERE episode_id = ?;

releaseQueueItem:
UPDATE queue SET pinned = 0, origin = 'auto' WHERE episode_id = ?;

deleteQueueItem:
DELETE FROM queue WHERE episode_id = ?;

deleteQueueForPodcast:
DELETE FROM queue WHERE episode_id IN (SELECT id FROM episodes WHERE podcast_id = ?);

-- Restore the 1024-gap scheme after a merge. Positions arrive from two devices
-- that numbered independently, so they can collide. The tie-break must be a
-- value both ends agree on: episode_id is a local rowid, assigned in feed-fetch
-- order, so two devices holding the same episode would break the same tie
-- differently and diverge for good. (feed, guid) is the identity peers address
-- each other by, so it is stable everywhere; media_url covers feeds with no
-- usable GUID.
queueOrderForRenumber:
SELECT q.episode_id FROM queue q
JOIN episodes e ON e.id = q.episode_id
JOIN podcasts p ON p.id = e.podcast_id
ORDER BY q.position, p.feed_url, COALESCE(e.guid, e.media_url);

-- ---------------------------------------------------------------- exclusions

isExcluded:
SELECT 1 FROM queue_exclusions WHERE episode_id = ?;

excludeEpisode:
INSERT OR REPLACE INTO queue_exclusions(episode_id, removed_at) VALUES (?, ?);

unexcludeEpisode:
DELETE FROM queue_exclusions WHERE episode_id = ?;

-- ---------------------------------------------------------------- intent

intentFor:
SELECT * FROM queue_intent WHERE episode_id = ?;

upsertIntent:
INSERT INTO queue_intent(episode_id, intent, position, pinned, origin, updated_at, updated_by)
VALUES (?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(episode_id) DO UPDATE SET
  intent = excluded.intent, position = excluded.position, pinned = excluded.pinned,
  origin = excluded.origin, updated_at = excluded.updated_at,
  updated_by = excluded.updated_by;

dropIntent:
DELETE FROM queue_intent WHERE episode_id = ?;

-- Intents for episodes finished long ago can't change any outcome, and every
-- one of them rides in every snapshot.
pruneIntents:
DELETE FROM queue_intent WHERE updated_at < ?
  AND episode_id IN (SELECT id FROM episodes WHERE state = 'played');

intentsForSnapshot:
SELECT i.*, e.guid, e.media_url, p.feed_url FROM queue_intent i
JOIN episodes e ON e.id = i.episode_id
JOIN podcasts p ON p.id = e.podcast_id
ORDER BY i.position;

-- Counted before the delete because SQLDelight's generated mutators return
-- Unit, and "how many settled intents did we reap" is worth logging.
countPrunableIntents:
SELECT COUNT(*) FROM queue_intent WHERE updated_at < ?
  AND episode_id IN (SELECT id FROM episodes WHERE state = 'played');
